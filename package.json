{
  "name": "boardhere",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:database": "node --test tests/database/*.test.mjs",
    "test:web": "node scripts/test-web.mjs",
    "setup:browser": "node scripts/setup-browser.mjs",
    "test:e2e": "node tests/e2e/browser.cjs",
    "db:seed": "node scripts/seed-db.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  },
  "overrides": {
    "rollup": "4.63.6"
  }
}
